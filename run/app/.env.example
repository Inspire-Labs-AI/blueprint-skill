# MProfit clone — example environment (Blueprint scaffold; no real secrets)
# Everything downstream of recon is INFERRED (no HAR / no authorized session).
# This is a scaffold, not a production system — fill in real values to run live.

# --- Database (Prisma datasource: prisma/schema.prisma) ---
# Postgres connection string. Local dev example:
DATABASE_URL="postgresql://mprofit:mprofit@localhost:5432/mprofit?schema=public"

# --- Inferred product API ("MProfit Cloud"), consumed by src/lib/api/client.ts ---
# Public base URL for the typed MProfitClient. Left as the inferred host by default.
# The client is stubbed but typed (api.live = false): the app renders mock fixtures,
# so this value is not actually contacted in the scaffold.
NEXT_PUBLIC_API_BASE_URL="https://api.mprofit.in"
